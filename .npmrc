# Refuse to resolve any version published less than this many days ago.
#
# Dependabot's cooldowns (.github/dependabot.yml, retired when the weekly
# dependency-update workflow arrived) were applied when Dependabot looked a
# version up, so they only governed the direct dependency a PR named — npm
# resolves everything underneath it with no cooldown at all. npm enforces
# this one at resolution time instead, which covers the weekly `npm update`
# batch, its transitive resolutions, and a local `npm install` alike.
#
# Only affects resolution — `npm ci` installs from the lockfile without
# resolving, so CI and Vercel builds are unchanged. If the window ever
# blocks an `npm audit fix`, npm keeps the vulnerable version and exits
# non-zero rather than failing quietly — add the package to
# min-release-age-exclude to take the fix immediately.
#
# The option landed in npm 11.10.0 and is silently ignored before that
# ("Unknown project config"), so engines.npm in package.json declares the
# floor and the weekly workflow raises the runner's npm to it before
# resolving anything.
min-release-age=5
